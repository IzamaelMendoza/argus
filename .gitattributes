# Finales de linea consistentes (los FASTA con CRLF dieron problemas en WSL)
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.fasta text eol=lf
*.fa text eol=lf
*.faa text eol=lf
*.tsv text eol=lf
*.md text eol=lf

# Archivos grandes -> Git LFS (modelos y matrices de caracteristicas)
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
data/interim/features_*.csv filter=lfs diff=lfs merge=lfs -text
